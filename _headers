/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=()
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests

/css/*
  Cache-Control: public, max-age=31536000, immutable

/js/*
  Cache-Control: public, max-age=31536000, immutable

/zangli.js
  Cache-Control: public, max-age=31536000, immutable

/eclipse.js
  Cache-Control: public, max-age=31536000, immutable

/*.png
  Cache-Control: public, max-age=31536000, immutable

/sw.js
  Cache-Control: no-cache

/calendar/*
  Content-Type: text/calendar; charset=utf-8
  Cache-Control: public, max-age=86400

# 年度数据给 AI 代理和其他程序读取（D023），允许跨域。
/data/*
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *
  Cache-Control: public, max-age=86400

/llms.txt
  Content-Type: text/plain; charset=utf-8
  Cache-Control: public, max-age=86400

# 仓库里的文档、脚本和测试会随站点一起发布；它们不是站点内容，不让搜索引擎收录。
/*.md
  X-Robots-Tag: noindex

/docs/*
  X-Robots-Tag: noindex

/scripts/*
  X-Robots-Tag: noindex

/tests/*
  X-Robots-Tag: noindex

/package.json
  X-Robots-Tag: noindex

/nginx.conf
  X-Robots-Tag: noindex
